# =================================================================
# SoftDrop CMS — Environment Variables
# =================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# =================================================================

# -----------------------------------------------------------------
# DATABASE (Neon.tech PostgreSQL — free tier)
# Get your connection string from: https://neon.tech
# -----------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST/softdrop?sslmode=require"

# -----------------------------------------------------------------
# NEXTAUTH.JS v5
# Generate AUTH_SECRET with: npx auth secret
# -----------------------------------------------------------------
AUTH_SECRET="your-auth-secret-32-chars-minimum"
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth (optional — leave blank to disable)
# Create app at: https://github.com/settings/developers
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# -----------------------------------------------------------------
# UPLOADTHING (File Storage — free 2GB)
# Get keys from: https://uploadthing.com
# -----------------------------------------------------------------
UPLOADTHING_SECRET="sk_live_..."
UPLOADTHING_APP_ID="your-app-id"

# -----------------------------------------------------------------
# UPSTASH REDIS (Rate Limiting — free 10k req/day)
# Get keys from: https://upstash.com
# -----------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# -----------------------------------------------------------------
# SITE CONFIGURATION
# -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="SoftDrop"
NEXT_PUBLIC_APP_DESCRIPTION="The modern software download portal"

# Admin initial setup (used by seed script only)
ADMIN_EMAIL="admin@softdrop.dev"
ADMIN_PASSWORD="changeme123!"
