// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema
//
// Full schema — all models for SoftDrop CMS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =====================================================================
// ENUMS
// =====================================================================

enum Role {
  ADMIN
  EDITOR
  USER
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

// =====================================================================
// USER MODEL
// =====================================================================

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  password  String?  // nullable for OAuth users
  role      Role     @default(USER)
  avatar    String?
  banned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  posts     Post[]
  comments  Comment[]
  downloads Download[]

  // NextAuth required fields
  accounts  Account[]
  sessions  Session[]

  @@map("users")
}

// =====================================================================
// NEXTAUTH ADAPTER MODELS
// (Required by @auth/prisma-adapter)
// =====================================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// =====================================================================
// CATEGORY MODEL
// =====================================================================

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  icon        String? // emoji or icon name (e.g., "💻" or "monitor")
  description String?
  parentId    String? // self-referential for nested categories

  // Self-relation: a category can have a parent category
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  // Posts in this category
  posts Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

// =====================================================================
// TAG MODEL
// =====================================================================

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  posts Post[] @relation("PostTags")

  @@map("tags")
}

// =====================================================================
// POST MODEL (the core entity — represents a software item)
// =====================================================================

model Post {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  description String     @db.Text
  content     String     @db.Text // Rich HTML from Tiptap
  thumbnail   String?    // URL to thumbnail image
  status      PostStatus @default(DRAFT)

  // Software-specific metadata
  version         String? // e.g., "2.1.4"
  fileSize        BigInt? // size in bytes
  fileUrl         String? // direct download URL or Uploadthing key
  osCompatibility String[] @default([]) // e.g., ["Windows", "macOS", "Linux"]

  // SEO fields
  seoTitle       String?
  seoDescription String?

  // Statistics (denormalized for fast reads)
  views         Int @default(0)
  downloadCount Int @default(0) // renamed to avoid conflict with downloads relation

  // Screenshots gallery (array of URLs)
  screenshots String[] @default([])

  // Relations
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  tags       Tag[]    @relation("PostTags")

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  comments  Comment[]
  downloads Download[] @relation("PostDownloads")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes for common query patterns
  @@index([slug])
  @@index([status])
  @@index([categoryId])
  @@index([authorId])
  @@index([createdAt])
  @@index([downloadCount])
  @@index([views])
  @@map("posts")
}

// =====================================================================
// COMMENT MODEL
// =====================================================================

model Comment {
  id      String        @id @default(cuid())
  content String        @db.Text
  status  CommentStatus @default(PENDING)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([userId])
  @@index([status])
  @@map("comments")
}

// =====================================================================
// DOWNLOAD RECORD MODEL
// =====================================================================

model Download {
  id        String   @id @default(cuid())
  ip        String?  // IP address for analytics (anonymized)
  userAgent String?
  createdAt DateTime @default(now())

  // Optional — null for anonymous downloads
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  postId String
  post   Post   @relation("PostDownloads", fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("downloads")
}

// =====================================================================
// SITE SETTINGS MODEL (key-value store)
// =====================================================================

model Setting {
  key       String   @id // e.g., "site_name", "maintenance_mode"
  value     String   @db.Text // JSON-serialized value
  updatedAt DateTime @updatedAt

  @@map("settings")
}
